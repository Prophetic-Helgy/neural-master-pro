{
  "appId": "com.neuralmasterpro.app",
  "productName": "Neural Master Pro 2.5",
  "directories": {
    "buildResources": "public",
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "main.cjs",
    "preload.cjs",
    "public/logo.ico"
  ],
  "extraResources": [
    "NeuralMasterTempServer.exe"
  ],
  "win": {
    "icon": "public/logo.ico",
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  }
}